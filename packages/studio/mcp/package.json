{
  "name": "@opendaw/studio-mcp",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "An MCP server and command line that edit an openDAW project with the Script API, headless, and render it with openDAW's engine",
  "type": "module",
  "bin": {
    "studio-mcp": "./bin/studio-mcp",
    "studio-mcp-verify": "./bin/studio-mcp-verify"
  },
  "scripts": {
    "build": "tsc && node build.mjs",
    "distribution": "node build.mjs --distribution",
    "lint": "eslint \"**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@opendaw/lib-box": "^0.0.96",
    "@opendaw/lib-dsp": "^0.0.95",
    "@opendaw/lib-std": "^0.0.86",
    "@opendaw/nam-wasm": "^1.2.0",
    "@opendaw/studio-adapters": "^0.3.6",
    "@opendaw/studio-boxes": "^0.0.112",
    "@opendaw/studio-core-wasm": "^0.0.19",
    "@opendaw/studio-scripting": "^0.0.88",
    "soundfont2": "^0.5.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@opendaw/eslint-config": "^0.0.28",
    "@opendaw/typescript-config": "^0.0.32",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "vitest": "^3.1.3"
  }
}
